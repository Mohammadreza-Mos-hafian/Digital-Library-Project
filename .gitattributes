# ==========================
# General line endings
# ==========================
# All text files should use LF, even on Windows
* text=auto eol=lf

# Shell scripts for Linux/macOS should use LF
*.sh text eol=lf

# Batch scripts for Windows should use CRLF
*.bat text eol=crlf

# Python files
*.py text eol=lf

# HTML, CSS, JS files
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf

# Markdown and text files
*.md  text eol=lf
*.txt text eol=lf

# ==========================
# Binary files
# ==========================
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.tar  binary
*.gz   binary
*.woff binary
*.woff2 binary
*.eot  binary
*.ttf  binary

# ==========================
# Merge control for specific files
# ==========================
# For example, lock files should always keep the local version
*.lock merge=ours

# ==========================
# Custom filters / diff (optional)
# ==========================
# Show Markdown files with optimized diff
*.md diff=markdown